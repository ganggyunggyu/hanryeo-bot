# ─────────────────────────────────────────────
# 필수: Cafe24 쇼핑몰 자격증명
# ─────────────────────────────────────────────
# 쇼핑몰 ID (관리자 로그인에 사용)
CAFE24_MALL_ID=hanryeodamwon
# 쇼핑몰 관리자 비밀번호 (QNA 답변 등 관리자 작업)
CAFE24_ADMIN_PASSWORD=
# 리뷰 계정 공용 비밀번호 (신규 생성 계정)
REVIEW_ACCOUNT_PASSWORD=
# 리뷰 계정 공용 비밀번호 (초기에 만든 구 계정)
REVIEW_ACCOUNT_PASSWORD_LEGACY=

# ─────────────────────────────────────────────
# 필수: 주문 정보
# ─────────────────────────────────────────────
# 주문서 수취인 연락처. 하이픈 포함/미포함 모두 자동 처리
ORDER_CONTACT_PHONE=010-0000-0000

# ─────────────────────────────────────────────
# 필수: 구글 시트 연동 (서비스 계정)
# ─────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 개행은 \n 으로 이스케이프해서 한 줄로 넣는다
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# ─────────────────────────────────────────────
# 선택: 캡차 우회 (2captcha)
# ─────────────────────────────────────────────
CAPTCHA_API_KEY=

# ─────────────────────────────────────────────
# 선택: 실행 옵션
# ─────────────────────────────────────────────
# 브라우저를 숨기고 실행 (true/false)
HEADLESS=true
# 실제 반영 없이 동작만 확인
DRY_RUN=false
# 로그 상세 출력
VERBOSE=false
# 한 번에 처리할 건수
BATCH_SIZE=
# 요청 간 지연 (밀리초)
MIN_DELAY=
MAX_DELAY=

# ─────────────────────────────────────────────
# 선택: 리뷰/이미지 배치 필터
# ─────────────────────────────────────────────
REVIEW_LIMIT=
REVIEW_PAGE_LIMIT=
TARGET_ACCOUNT_ID=
TARGET_NAME_PREFIX=
TARGET_REVIEW_NO=
TARGET_SUCCESS=
# 이미지 변환 옵션
IMAGE_DIRS=
ONLY_NUMBERED=
OVERWRITE=
QUALITY=
MAX_SIZE=
